      ]
    },
    {
      "name": "Exclusao",
      "item": [
        {
          "name": "Excluir usuario - Sucesso",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Excluir usuario - Erro (ID inexistente)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/users/999",
              "host": ["{{baseUrl}}"],
              "path": ["users", "999"]
            }
          }
        }
      ]
    }
